# API server configuration
SERVER_PORT=8081
LOG_LEVEL=info
ENVIRONMENT=development

# Required: PostgreSQL connection URL
DATABASE_URL=postgres://yiguan:yiguan@localhost:15432/yiguan?sslmode=disable

# Required: Redis connection URL
REDIS_URL=redis://localhost:16379/0

# Required: S3-compatible object storage (MinIO for local development)
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=yiguan
S3_SECRET_ACCESS_KEY=yiguanminio
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Required: JWT signing key (use a strong secret in production)
JWT_SIGNING_KEY=replace-me-in-production

# Required: HMAC key for hashing email verification codes
EMAIL_CODE_KEY=replace-me-in-production-email-code-key

# Required: outbound email sender address
EMAIL_FROM=noreply@example.com

# Email adapter: console or smtp
EMAIL_ADAPTER=smtp

# Access and refresh token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Required: public base URL used for links and callbacks
PUBLIC_BASE_URL=http://localhost:8081

# SMTP settings for local Mailpit capture
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

# Test database target
TEST_DATABASE_URL=postgres://yiguan:yiguan@localhost:15433/yiguan_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:16379/1

# Optional: CORS allowed origins (comma-separated). In development an empty
# value defaults to "*"; in production explicit origins are required.
CORS_ALLOWED_ORIGINS=

# Optional: trust X-Forwarded-For / X-Real-IP when rate limiting requests
# behind a reverse proxy.
RATE_LIMIT_BEHIND_PROXY=false

# Optional: comma-separated list of staff usernames. Staff members receive
# an `isStaff` claim in their access token and can access moderation endpoints.
STAFF_USERNAMES=admin

# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
# Test secret (always passes): 1x0000000000000000000000000000000AA
# Test site key (always passes): 1x000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=

DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_HEALTH_CHECK_PERIOD=5m
